# ============================================================
# FEMINNITA MARKETING STRATEGY — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no repositório
# ============================================================

# ---- Banco de Dados (TiDB Cloud / MySQL) -------------------
DATABASE_URL=mysql://user:password@host:4000/feminnita?ssl={"rejectUnauthorized":true}

# ---- Autenticação Manus OAuth ------------------------------
OAUTH_SERVER_URL=https://auth.manus.space
OWNER_OPEN_ID=seu_open_id_aqui
JWT_SECRET=chave_secreta_jwt_minimo_32_caracteres
VITE_APP_ID=seu_app_id_manus

# ---- Meta / Facebook Ads -----------------------------------
META_ACCESS_TOKEN=seu_token_de_acesso_meta
META_AD_ACCOUNT_ID=act_123456789
META_PIXEL_ID=123456789
META_PAGE_ID=123456789

# ---- Bling ERP ---------------------------------------------
BLING_CLIENT_ID=seu_client_id_bling
BLING_CLIENT_SECRET=seu_client_secret_bling

# ---- Melhor Envio ------------------------------------------
MELHOR_ENVIO_TOKEN=seu_token_melhor_envio

# ---- AWS S3 (armazenamento de mídia) -----------------------
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key
AWS_REGION=sa-east-1
AWS_S3_BUCKET=feminnita-media

# ---- LLM (Manus Forge API) ---------------------------------
BUILT_IN_FORGE_API_URL=https://api.manus.space/forge
BUILT_IN_FORGE_API_KEY=sua_forge_api_key

# ---- Configuração do Servidor ------------------------------
NODE_ENV=production
PORT=3000
