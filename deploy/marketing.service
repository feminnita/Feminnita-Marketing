[Unit]
Description=Feminnita Marketing Platform
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/marketing
EnvironmentFile=/opt/marketing/.env
ExecStart=/usr/bin/node /opt/marketing/dist/index.js
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=marketing

[Install]
WantedBy=multi-user.target
